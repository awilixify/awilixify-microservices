{
	"name": "@awilixify/microservices",
	"version": "0.1.0",
	"description": "Typed, module-scoped messaging for Awilixify with transport-specific adapters.",
	"type": "module",
	"license": "MIT",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./rabbitmq": {
			"types": "./dist/lib/rabbitmq/index.d.ts",
			"import": "./dist/lib/rabbitmq/index.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"sideEffects": false,
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"check-types": "tsc --noEmit",
		"lint": "biome check index.ts lib test",
		"lint:fix": "biome check --write index.ts lib test",
		"test": "npm run check-types && npm run test:runtime",
		"prepack": "npm run lint && npm test && npm run build",
		"test:runtime": "vitest run"
	},
	"peerDependencies": {
		"awilixify": "^3.5.1",
		"amqp-connection-manager": "^5.0.0",
		"amqplib": "^2.0.1"
	},
	"peerDependenciesMeta": {
		"amqp-connection-manager": {
			"optional": true
		},
		"amqplib": {
			"optional": true
		}
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.4",
		"@swc/core": "^1.15.33",
		"@types/node": "^22.15.21",
		"amqp-connection-manager": "^5.0.0",
		"amqplib": "^2.0.1",
		"awilix": "^13.0.0",
		"awilixify": "^3.5.1",
		"typescript": "^5.9.3",
		"unplugin-swc": "^1.5.9",
		"vitest": "^5.0.5"
	}
}
